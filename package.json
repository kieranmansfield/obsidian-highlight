{
	"name": "obsidian-highlight",
	"version": "0.1.0",
	"description": "Semantic classes for native ==emoji== highlight marks.",
	"main": "main.js",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"test": "vitest run",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"update": "ncu -i",
		"lint": "eslint --fix",
		"lint:fix": "eslint . --fix",
		"format": "prettier --config prettier.config.cjs --ignore-path .prettierignore --write .",
		"format:check": "prettier --config prettier.config.cjs --ignore-path .prettierignore --check ."
	},
	"keywords": [],
	"author": "Kieran Mansfield",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "^9.39.4",
		"@types/node": "^26.6.2",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"esbuild": "0.28.2",
		"eslint": "^10.11.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"prettier": "^3.9.8",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^5.0.1"
	}
}
